# Generate a separate access token for each installation, e.g. secrets.token_urlsafe(32).
CARE_BACKEND_TOKENS=replace-with-a-random-token-at-least-32-characters
# openai, kimi, compatible. Model IDs are explicit: choose one available to your account.
CARE_PROVIDER=compatible
CARE_MODEL_BASE_URL=https://your-compatible-provider.example/v1
CARE_MODEL_API_KEY=server-side-provider-key
CARE_MODEL_NAME=your-model
CARE_MODEL_MAX_OUTPUT_TOKENS=6000
# Bounds cost per upload. Original evidence stays local even when over this limit.
CARE_MAX_SOURCE_CHARACTERS=40000
# Sampling is omitted by default for compatibility with reasoning models.
# CARE_MODEL_TEMPERATURE=0
# Kimi adapter defaults to thinking disabled; never force temperature=0 for K2.6.
# CARE_MODEL_THINKING=disabled
# Optional for models that support it:
# CARE_MODEL_REASONING_EFFORT=low
# Optional fallback, enabled only when all its settings are configured:
# CARE_FALLBACK_BASE_URL=https://another-compatible-provider.example/v1
# CARE_FALLBACK_PROVIDER=openai
# CARE_FALLBACK_API_KEY=server-side-fallback-key
# CARE_FALLBACK_MODEL=your-fallback-model
# CARE_FALLBACK_MAX_OUTPUT_TOKENS=6000
# Explicit offline backend development adapter:
# CARE_PROVIDER=mock
# CARE_ALLOW_MOCK=true
