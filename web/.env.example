# Set in your terminal/Render settings. web.run does not auto-load this file.
CARE_WEB_ORIGIN=http://127.0.0.1:8080
# Optional: leave all cloud settings unset for local-only workflows.
# Existing Render API remains separate from this web server.
# CARE_WEB_GATEWAY_URL=https://careinone-api.onrender.com
# CARE_WEB_GATEWAY_TOKEN=<dedicated operator-issued gateway token, 32+ chars>
# CARE_WEB_SESSION_SECRET=<random secret, 32+ chars>
# CARE_WEB_ACCESS_CODES=<one or more comma-separated random codes, 32+ chars>
CARE_WEB_DAILY_LIMIT=10
CARE_WEB_GLOBAL_DAILY_LIMIT=100

# Single existing Render service mode (no additional hosting service):
# CARE_WEB_COMBINED=true
# Retain the current CARE_BACKEND_TOKENS and provider settings on that service.
# CARE_WEB_GATEWAY_TOKEN can be omitted in combined mode; the first server token is used internally.

# Explicit deadline fallback: browser-local web workflows, while native /v1/* stays intact.
# CARE_WEB_CLOUD_ENABLED=false
# Default true keeps cloud setup fail-closed: configure secret/codes before enabling it.

# Public visitors can analyze without an operator code when explicitly enabled.
# Reuses the server session secret and gateway token. Source consent still required.
# CARE_WEB_PUBLIC_AI=true
# Anonymous session: 10 attempts/day; shared process: 100/day; counters reset on restart.
# Clearing cookies can create a new session but cannot bypass the shared process cap.
